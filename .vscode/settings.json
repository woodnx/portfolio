{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "textlint.autoFixOnSave": true,
  "textlint.run": "onType",
  "textlint.languages": [
    "markdown",
    "mdx"
  ],
  "editor.formatOnSave": true,
  "editor.wordWrap": "on",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
