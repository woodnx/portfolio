  "files.associations": {
    "*.css": "tailwindcss"
  },
  "textlint.autoFixOnSave": true,
  "textlint.languages": [
    "markdown"
  ],
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}