---
import "@/styles/github.css";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/components/Badge.astro";
import ProfileCard from "@/components/ProfileCard.astro";
import SidebarSwitcher from "@/components/SidebarSwitcher.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import dayjs from "dayjs";
import YouTube from "@/components/YouTube.astro";
import PageLink from "@/components/PageLink.astro";

export async function getStaticPaths() {
  const workEntries = await getCollection("work");
  return workEntries.map((entry) => ({
    params: { slug: entry.id, id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const lastModified = remarkPluginFrontmatter.lastModified;
const modified = lastModified && dayjs(lastModified).format("YYYY/MM/DD");
const developedStart = dayjs(entry.data.developedStart).format("YYYY/MM～");
const developedEnd = entry.data.developedEnd
  ? dayjs(entry.data.developedStart).format("YYYY/MM")
  : "";
const developed = developedStart + developedEnd;
const links = entry.data.links;
---

<BaseLayout pageTitle={entry.data.title}>
  <SidebarSwitcher slot="sidebar" defaultTab="toc">
    <ProfileCard slot="profile" />
    <TableOfContents slot="toc" headings={headings} />
  </SidebarSwitcher>

  <p class="text-sky-600 font-bold text-4xl my-4">
    {entry.data.title}
  </p>
  <div class="flex flex-wrap gap-x-5 gap-y-1 mb-2">
    <div class="flex items-center gap-0.5 tooltip" data-tip="記事作成日">
      <Icon name="tabler:pencil" />
      <p>{entry.data.publishedAt}</p>
    </div>
    {
      modified && (
        <div class="flex items-center gap-0.5 tooltip" data-tip="記事更新日">
          <Icon name="tabler:refresh" />
          <p>{modified}</p>
        </div>
      )
    }
    <div class="flex items-center gap-0.5 tooltip" data-tip="開発期間">
      <Icon name="tabler:device-imac" />
      <p>{developed}</p>
    </div>
    {
      links && (
        <div class="tagbar flex gap-5 overflow-x-auto">
          {links.map((link) => {
            const isGithub = link.includes("github.com");
            const icon = isGithub
              ? "tabler:brand-github-filled"
              : "tabler:world";
            const label = isGithub ? "Github" : "サイト";
            return <PageLink label={label} link={link} icon={icon} />;
          })}
        </div>
      )
    }
  </div>

  <div class="flex flex-wrap gap-x-5 gap-y-1 mb-6">
    {
      (
        <Badge
          label={entry.data.category}
          link={`/categories/${entry.data.category}`}
          icon="tabler:category"
        />
      )
    }

    {
      entry.data.tags && (
        <div class="tagbar flex gap-2 overflow-x-auto">
          {entry.data.tags?.map((tag) => (
            <Badge label={tag} link={`/tags/${tag}`} icon="tabler:tag" />
          ))}
        </div>
      )
    }
  </div>

  <article class="grow w-12/12">
    <hr class="h-1.5 border-t-0 bg-sky-600 rounded-t-full" />
    <div
      data-pagefind-body
      class="markdown-body px-8 py-6 rounded-b-lg bg-white"
    >
      <Content components={{ YouTube }} />
    </div>
  </article>
</BaseLayout>
