---
import { execSync } from "child_process";
import dayjs from "dayjs";

const result = execSync('git log -1 --pretty="format:%cI"');
const lastModified = dayjs(result.toString()).format('YYYY/MM/DD');
---
<footer class="flex flex-col font-bold">
  <span class="self-center">© 2025 woodnx.com | Powered by Astro</span>
  <span class="self-center">Last modified: {lastModified}</span>
</footer>