---
import { Image } from "astro:assets";

interface Props {
  title: string;
  image: ImageMetadata;
  description?: string;
  id: string;
  tags?: string[];
}

const { title, description, image, id } = Astro.props;
---

<div class="relative rounded-2xl">
  <a href={`/works/${id}`}>
    <figure>
      <Image
        src={image}
        alt=""
        inferSize
        class="rounded-2xl object-cover aspect-square"
      />
    </figure>
    <div
      class="absolute flex flex-col justify-end p-3 pt-2 w-full h-1/3 left-0 bottom-0 bg-neutral-500 text-white opacity-0 hover:opacity-100 rounded-b-2xl"
    >
      <h3 class="text-2xl">{title}</h3>
      <p class="mb-2 line-clamp-1">
        {description}
      </p>
    </div>
  </a>
</div>
