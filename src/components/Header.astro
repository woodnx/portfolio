---
import Navigation from "./Navigation.astro";

interface Props {
  class?: string;
  title?: string;
}

const { class: className, title = "@woodnx.com" } = Astro.props;
---

<header
  class:list={[
    "flex justify-between items-center px-10 pt-3 pb-4 bg-white rounded-b-4xl h-16 min-h-16",
    className,
  ]}
>
  <a
    class="hover:bg-sky-200/50 active:bg-sky-200/50 text-sky-600 px-3 py-2 rounded-xl transition-colors duration-200 font-bold text-xl"
    href="/">{title}</a
  >

  <!-- デスクトップ用ナビゲーション -->
  <div class="hidden lg:block">
    <Navigation />
  </div>

  <!-- モバイル用ドロップダウンメニュー  -->
  <div class="dropdown dropdown-end lg:hidden">
    <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h7"></path>
      </svg>
    </div>
    <ul
      tabindex="0"
      class="menu dropdown-content bg-base-100 rounded-2xl z-[1] mt-6 w-30 p-2 border-2 border-sky-100"
    >
      <li>
        <a
          href="/"
          class="font-bold rounded-xl hover:bg-sky-200/50 hover:text-sky-600 active:bg-sky-200/50 active:text-sky-600"
          >Top</a
        >
      </li>
      <li>
        <a
          href="/chronicles/"
          class="font-bold rounded-xl hover:bg-sky-200/50 hover:text-sky-600 active:bg-sky-200/50 active:text-sky-600"
          >Chronicles</a
        >
      </li>
      <li>
        <a
          href="/works/"
          class="font-bold rounded-xl hover:bg-sky-200/50 hover:text-sky-600 active:bg-sky-200/50 active:text-sky-600"
          >Works</a
        >
      </li>
      <li>
        <a
          href="/blog/"
          class="font-bold rounded-xl hover:bg-sky-200/50 hover:text-sky-600 active:bg-sky-200/50 active:text-sky-600"
          >Blog</a
        >
      </li>
    </ul>
  </div>
</header>

<style>
  /* スマホタップ時のスタイル対応 */
  .dropdown-content a {
    -webkit-tap-highlight-color: var(--color-sky-200);
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
  }

  /* iOS Safari での :active 疑似クラスを有効にする */
  .dropdown-content a:active {
    background-color: var(--color-sky-200) !important;
    color: var(--color-sky-600) !important;
  }

  /* タッチデバイスでの追加対応 */
  @media (hover: none) and (pointer: coarse) {
    .dropdown-content a:active {
      background-color: var(--color-sky-200) !important;
      color: var(--color-sky-600) !important;
      transform: scale(0.98);
    }
  }
</style>
